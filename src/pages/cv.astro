---
import Head from '../components/layout/head.astro'
import PageLayout from '../components/layout/page-layout.astro'
import { SOCIAL_LINKS } from '../utils/constant'

function md(text: string): string {
	return text
		.replace(
			/\*\*([^*]+)\*\*/g,
			'<strong class="text-foreground-accent font-medium print:text-foreground-primary">$1</strong>',
		)
		.replace(/\*([^*]+)\*/g, '<em>$1</em>')
		.replace(
			/\[([^\]]+)\]\(([^)]+)\)/g,
			'<a href="$2" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 decoration-foreground-secondary/40 hover:decoration-foreground-secondary transition-colors inline-flex items-baseline gap-0.5">$1<img src="/icons/external-link.svg" class="inline-block w-3 h-3 self-center opacity-50 shrink-0" aria-hidden="true" /></a>',
		)
}

const links = [
	{ label: 'linkedin.com/in/jibin2706', href: SOCIAL_LINKS.linkedin.url },
	{ label: 'github.com/jibin2706', href: SOCIAL_LINKS.github.url },
	{ label: SOCIAL_LINKS.email.display, href: SOCIAL_LINKS.email.url },
]

const summary =
	'Full Stack Tech Lead with 7 years of experience building scalable products across React, TypeScript, Node.js, and cloud infrastructure. Currently leading engineering across AI platforms, backend services, architecture, and end-to-end product delivery at Pepper Content.'

const experience = [
	{
		company: 'Pepper Content',
		website: 'https://www.pepper.inc/',
		location: 'Mumbai, India',
		title: 'Full Stack Tech Lead',
		period: 'June 2020 – Present',
		roles: [
			{ title: 'Full Stack Tech Lead', period: 'Apr 2026 – Present' },
			{ title: 'SDE III - Frontend', period: 'Apr 2023 – Mar 2026' },
			{ title: 'SDE II - Frontend', period: 'Aug 2021 – Mar 2023' },
			{ title: 'Frontend Developer', period: 'Jun 2020 – Jul 2021' },
		],
		projects: [
			{
				name: 'Atlas – GEO (AI Visibility & Analytics)',
				period: 'Jul 2025 – Present',
				points: [
					'**Architected and built Atlas from scratch**, defining the data model, BFF access patterns, technology stack, workspace architecture, onboarding flows, and analytics experience.',
					'Built a full-stack GEO analytics platform for tracking domain coverage, brand visibility, and domain share across AI search engines.',
					'Designed and built a **distributed Prompt Automation Service** for executing prompts across ChatGPT, Gemini, Perplexity, and Google AI Overview.',
					'Implemented asynchronous job queues, dynamic proxy selection, **multi-region execution, and spot-instance autoscaling** to support reliable prompt execution at scale.',
				],
			},
			{
				name: 'Nymbus – AI Workflow Builder',
				period: 'Apr 2024 – Jul 2025',
				points: [
					'**Took Nymbus from POC to a production-grade visual workflow platform**, replacing Retool as the company’s internal foundation for building AI applications across multiple use cases.',
					'Built a **canvas-based workflow editor** supporting LLM, image generation, transformation, knowledge base, video, and audio steps.',
					'Developed a simulation environment for end-to-end workflow testing and implemented role-based access control across the platform.',
					'Built a lightweight **authentication proxy using Cloudflare Workers** to securely bridge frontend and backend services, then led the migration from Clerk to an internal identity service with integrated role management.',
				],
			},
			{
				name: 'Pepper Docs – Editor Platform & AI Features',
				period: 'Dec 2022 – Jul 2025',
				points: [
					'**Led Docs v2**, consolidating duplicated editor implementations across the platform into a shared monorepo package and unifying architecture across YJS and non-YJS document types.',
					'Built **Pepper AI**, an in-document AI assistant with conversational chat, contextual quick actions, and streaming responses.',
					'Built a **Content Audit workflow** for readability, grammar, citations, plagiarism, and fact-checking using an asynchronous processing pipeline.',
					'Developed custom ProseMirror extensions, published a typed fork of [htmldiff-js](https://github.com/jibin2706/htmldiff-javascript), and [contributed fixes](https://github.com/remirror/remirror/pull/2339) for interoperability issues across Remirror, ProseMirror, and YJS.',
					'Maintained the NestJS editor service and diagnosed production issues involving **YJS data corruption, multi-client race conditions, IndexedDB persistence, and WebSocket reconnection**.',
				],
			},
			{
				name: 'Platform & Growth Engineering',
				period: 'Jun 2020 – Sep 2022',
				points: [
					'Redesigned the monorepo deployment strategy by consolidating fragmented AWS Amplify, Cloudflare Pages, and GitHub Actions deployments into a unified Cloudflare Pages pipeline across staging and production.',
					'Incrementally migrated the marketing site from Gatsby to Next.js using ISR and SSR, integrating Strapi for custom pages and headless WordPress for blog content.',
					'Built and shipped the PepperType Chrome extension.',
				],
			},
		],
	},
	{
		company: 'The Souled Store',
		website: 'https://www.thesouledstore.com/',
		location: 'Mumbai, India',
		title: 'Frontend Developer',
		period: 'Jul 2019 – Jun 2020',
		roles: [{ title: 'Junior Frontend Developer', period: 'Jul 2019 – Jun 2020' }],
		summary: '',
		points: [
			'Migrated the ecommerce site from a client-side SPA to Next.js SSR, improving search-engine accessibility and initial page rendering.',
			'Worked closely with the SEO team on technical and on-page SEO improvements.',
			'Built backend APIs using Falcon (Python) and automated sitemap generation and order-health reporting to Slack.',
		],
		projects: [],
	},
]

const skills = {
	frontend: [
		'React.js',
		'TypeScript',
		'Next.js',
		'Vite',
		'TanStack Router / Start',
		'Tailwind CSS',
		'React Flow',
		'ProseMirror/Remirror',
		'YJS',
	],
	backend: ['Node.js', 'Bun', 'NestJS', 'Hono', 'BullMQ', 'REST APIs'],
	'state management': ['TanStack Query', 'Zustand', 'XState'],
	data: ['PostgreSQL', 'MySQL', 'Redis'],
	'Cloud & DevOps': [
		'AWS - S3, CloudFront, ECS, Lambda',
		'Cloudflare - Pages, Workers, DNS',
		'Docker',
		'GitHub Actions',
	],
	observability: ['ELK Stack', 'Elastic APM', 'Kibana Dashboards'],
	// 'engineering areas': [
	// 	'Full-stack architecture',
	// 	'distributed asynchronous systems',
	// 	'AI application infrastructure',
	// 	'collaborative editing',
	// 	'authentication & authorization',
	// 	'system design',
	// ],
}

const education = [
	{ degree: 'Master of Computer Applications', institution: 'LPU', year: '2022–2024' },
	{ degree: "Bachelor's in Information Technology", institution: 'Wilson College', year: '2018–2020' },
]
---

<PageLayout currentPath="/cv">
	<Head slot="head" title="CV - Jibin Thomas" description={summary} />
	<main class="mx-auto mt-20 mb-40 max-w-300 px-5 print:my-0 print:max-w-full print:px-4">
		<div class="flex flex-col gap-16 print:gap-5">
			<section
				class="border-border-subtle hover:border-border-strong space-y-4 border-b pb-8 transition-colors print:space-y-2 print:pb-3"
			>
				<div class="flex items-center justify-between">
					<h1 class="font-cormorant text-5xl print:text-3xl">Jibin Thomas</h1>
				</div>
				<p class="text-lg leading-relaxed font-light print:text-xs">{summary}</p>
				<div class="flex items-center gap-3">
					{
						links.map((link, i) => (
							<>
								{i > 0 && <span class="text-foreground-secondary">·</span>}
								<a
									href={link.href}
									target="_blank"
									rel="noopener noreferrer"
									class="info hover:text-foreground inline-flex items-center gap-1 normal-case! transition-colors"
								>
									{link.label}
								</a>
							</>
						))
					}
				</div>
			</section>

			<section>
				<h2 class="sub-heading mb-1">Experience</h2>
				<div class="grid gap-8 print:gap-2">
					{
						experience.map((job) => (
							<div class="border-border-subtle hover:border-border-strong border-b pb-6 transition-colors print:pb-2">
								<div class="mb-2">
									<div class="flex items-center justify-between gap-4">
										<p class="font-cormorant text-xl print:text-xl">
											<a href={job.website} target="_blank" rel="noopener noreferrer">
												{job.company}
											</a>
											— {job.title}
										</p>
										<p class="info">{job.period}</p>
									</div>
									{job.summary && (
										<p class="text-foreground-secondary mt-3 text-base leading-relaxed font-light print:text-xs">
											{job.summary}
										</p>
									)}
								</div>

								{job.points && job.points.length > 0 && (
									<ul class="list-disc space-y-1 pl-5 print:space-y-0">
										{job.points.map((point) => (
											<li
												class="text-foreground-secondary text-base leading-relaxed font-light print:text-xs"
												set:html={md(point)}
											/>
										))}
									</ul>
								)}

								{job.projects.length > 0 && (
									<div class="mt-2 space-y-4 print:mt-2 print:space-y-2">
										<div class="space-y-4 print:space-y-2">
											{job.projects.map((project) => (
												<div>
													<div class="mb-1.5 flex flex-wrap items-center justify-between gap-2">
														<p class="text-base font-medium print:text-xs">
															{project.name}
														</p>
														<p class="info">{project.period}</p>
													</div>
													<ul class="list-disc space-y-1 pl-5 print:space-y-0">
														{project.points.map((point) => (
															<li
																class="text-foreground-secondary text-base leading-relaxed font-light print:text-xs"
																set:html={md(point)}
															/>
														))}
													</ul>
												</div>
											))}
										</div>
									</div>
								)}
							</div>
						))
					}
				</div>
			</section>

			<section>
				<h2 class="sub-heading mb-1 print:mb-1">Technical Skills</h2>
				<div class="grid gap-0">
					{
						Object.entries(skills).map(([category, items]) => (
							<div class="border-border-subtle hover:border-border-strong gap-2 border-b py-4 text-base transition-colors print:py-1 print:text-xs">
								<span class="text-foreground-secondary capitalize">{category}: </span>
								<span class="font-light">{items.join(', ')}</span>
							</div>
						))
					}
				</div>
			</section>

			<section>
				<h2 class="sub-heading mb-1 print:mb-1">Education</h2>
				<div class="grid gap-0">
					{
						education.map((edu) => (
							<div class="border-border-subtle hover:border-border-strong flex flex-wrap items-baseline justify-between gap-2 border-b py-4 transition-colors print:py-0.5">
								<div>
									<p class="font-cormorant text-xl print:text-base">{edu.degree}</p>
									<p class="text-foreground-secondary print:text-xs">{edu.institution}</p>
								</div>
								<span class="info">({edu.year})</span>
							</div>
						))
					}
				</div>
			</section>

			<section>
				<button
					onclick="window.print()"
					class="text-foreground-secondary hover:text-foreground border-border-subtle hover:border-border-strong border px-4 py-2 uppercase transition-colors print:hidden"
					>Download CV</button
				>
			</section>
		</div>
	</main>
</PageLayout>

<style is:global>
	@reference '../styles/global.css';

	.sub-heading {
		@apply text-foreground-secondary text-sm tracking-widest uppercase print:text-[10px];
	}

	.info {
		@apply text-foreground-secondary text-xs tracking-widest uppercase print:text-[8px];
	}

	@media print {
		header,
		nav,
		footer {
			display: none;
		}
	}
</style>
